{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dynamic-workers-demo",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-22",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"worker_loaders": [{ "binding": "LOADER" }],
	"vars": {
		"LOADER_COMPAT_DATE": "2026-06-22",
		"TURNSTILE_SITEKEY": "1x00000000000000000000AA",
	},
	"ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
	"durable_objects": {
		"bindings": [{ "name": "LOG_SESSION", "class_name": "LogSession" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LogSession"] }],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
	},
}
