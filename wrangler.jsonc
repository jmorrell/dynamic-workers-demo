{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dynamic-workers-demo",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-22",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"worker_loaders": [{ "binding": "LOADER" }],
	"vars": {
		// Inert in production (Dynamic Worker compat dates are hard-coded in
		// src/runtime/loader.ts / src/examples/registry.ts). Declared here only so
		// vitest.config.mts's test-only override has a typed binding to widen; see
		// src/runtime/loader.ts.
		"LOADER_COMPAT_DATE": "2026-06-22",
		"TURNSTILE_SITEKEY": "1x00000000000000000000AA",
		// "production" on deploy; overridden to "development" via .dev.vars during
		// `wrangler dev` to bypass the Turnstile gate locally. See src/index.ts.
		"ENVIRONMENT": "production",
	},
	"ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
	"durable_objects": {
		"bindings": [
			{ "name": "LOG_SESSION", "class_name": "LogSession" },
			// Supervisor DO for the storage capability (also hosts the per-IP store
			// registry singleton). See src/runtime/storage-host.ts.
			{ "name": "STORAGE_HOST", "class_name": "StorageHost" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["LogSession"] },
		// Only the supervisor class is declared; the facet class (StorageHarness,
		// from the loaded worker) is NOT declared here. The v2 tag is reused from
		// the throwaway spike (nothing was deployed).
		{ "tag": "v2", "new_sqlite_classes": ["StorageHost"] },
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
	},
}
